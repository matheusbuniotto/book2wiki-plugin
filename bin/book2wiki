#!/bin/sh
# Portable launcher for the book2wiki extractor.
#
# Runs the extractor with whatever Python runtime the user has, so the plugin
# works even when `uv` isn't installed:
#   1. uv            — zero setup, installs deps from the script's PEP 723 metadata
#   2. cached venv   — built once with python3 + pip if uv is absent
#   3. clear error   — exact install steps if neither is available
#
# The agent (book-extract skill) can also offer to install uv when this fails.

set -eu

# Resolve this script's real directory (follow symlinks) to find the extractor.
src="$0"
while [ -h "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
DIR=$(cd -P "$(dirname "$src")" && pwd)
SCRIPT="$DIR/book2wiki-extract.py"

# 1. Prefer uv.
if command -v uv >/dev/null 2>&1; then
    exec uv run --script "$SCRIPT" "$@"
fi

# 2. Fall back to a cached virtualenv (created once on first run).
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/book2wiki"
VENV="$CACHE/venv"
PY="$VENV/bin/python"
if [ ! -x "$PY" ] && command -v python3 >/dev/null 2>&1; then
    echo "book2wiki: 'uv' not found — building a one-time virtualenv at $VENV ..." >&2
    if python3 -m venv "$VENV" >/dev/null 2>&1; then
        "$PY" -m pip install --quiet --upgrade pip >/dev/null 2>&1 || true
        # Unpinned on purpose: let pip pick versions compatible with the user's
        # Python (the strict pins in the PEP 723 header are for the uv path, which
        # manages its own modern Python). The extractor works on older releases too.
        if ! "$PY" -m pip install --quiet pymupdf ebooklib html2text >/dev/null 2>&1; then
            echo "book2wiki: couldn't install dependencies (offline, or Python too old)." >&2
            rm -rf "$VENV"
        fi
    fi
fi
if [ -x "$PY" ]; then
    exec "$PY" "$SCRIPT" "$@"
fi

# 3. No usable runtime — tell the user exactly what to do.
cat >&2 <<'EOF'
book2wiki: no Python runtime available to run the extractor.

Install uv (recommended — one line, no admin):
    curl -LsSf https://astral.sh/uv/install.sh | sh

…or make sure python3 + pip are on your PATH and re-run.
EOF
exit 1
